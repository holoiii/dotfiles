# Aliases
alias sbp='source ~/.bash_profile'
alias valias='vim ~/.bash_profile'
alias gs='git show'
alias gst='git status'
alias gaa='git add --all'
alias gdc='git diff --cached'
alias gpr='git pull --rebase'
alias gpo='git push origin'
alias gd='git diff'
alias gl='git log'
alias br='git branch'
alias ll='ls -al'
alias vim='nvim'
alias vi='nvim'

#Default editor
export EDITOR=vim
